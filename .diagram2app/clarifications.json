  "statements": [
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR01: The Smart City application shall provide six modules: Administration, Tourism, Student, Sport Events, Job Applicant, and Business."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR02: The Administration module shall manage city information and user profiles."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR03: The Tourism module shall provide information about hotels, restaurants, tourist attractions, ATMs, theatres, and related services."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR04: Users shall be able to search and view tourism information."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR05: The Student module shall provide information about universities, colleges, libraries, coaching centres, and educational establishments."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR06: Educational establishments shall be associated with a city."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR07: The Sport Events module shall display sporting events, dates, venues, and locations."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR08: Users shall be able to reserve or purchase tickets for sporting events."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR09: Every sporting event shall be associated with a venue."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR10: The Job Applicant module shall display job opportunities in different industries."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR11: Each job listing shall be associated with a company or employer."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR12: The Business module shall provide information about businesses, industries, business centres, and relevant news."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR13: Users shall be able to search and view city information across the six modules."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR14: Location information shall be displayed on a map when coordinates are available."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR15: Registered users shall have unique email addresses."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR16: A registered user may have multiple roles, including USER, STUDENT, ADMIN, and TOURIST."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR17: Students shall be able to manage their own CV records."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR18: Registered users shall be able to submit job applications."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR19: Job applications shall not be submitted after the job deadline."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR20: A user shall not have duplicate active applications for the same job."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR21: Registered users shall be able to view their own bookings and job applications."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR22: A venue reservation shall have a start time earlier than its end time."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR23: Confirmed venue reservations shall not overlap for the same venue."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR24: Users shall be able to save and view favourite city listings."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR25: Only authorised administrators shall modify protected city records."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR26: Users shall only modify their own personal information, CVs, bookings, and applications unless explicitly authorised."
    },
    {
      "applies_to": null,
      "kind": "business_rules",
      "text": "BR27: Detailed authentication and authorisation rules shall be finalised during the security implementation phase."
    }
  ],
